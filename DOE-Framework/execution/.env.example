# Zoho OAuth credentials (from https://api-console.zoho.com/)
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REDIRECT_URI=http://localhost:5000/callback

# Zoho access token (set after running zoho_token_exchange.py or via /zoho/authorize)
ZOHO_API_KEY=your_zoho_access_token

# Only needed when running zoho_token_exchange.py directly
ZOHO_AUTH_CODE=paste_code_from_oauth_step_here

# GST Portal credentials (from https://www.gst.gov.in/)
GST_USER_ID=your_gst_user_id
GST_PASSWORD=your_gst_password
GST_CLIENT_ID=your_gst_client_id
GST_CLIENT_SECRET=your_gst_client_secret

# Flask
FLASK_SECRET_KEY=change-to-a-random-secret-in-production

# Environment Variables
# Copy this file to .env and fill in your API keys
# NEVER commit .env to git!

# Flask session signing key — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# First login is created automatically the first time the app starts with an
# empty user database. Change the password after first login.
INITIAL_ADMIN_USER=
INITIAL_ADMIN_PASSWORD=

# Optional — only needed if exporting workflow charts / master workbook to Google Sheets
GOOGLE_SHEETS_CREDENTIALS_FILE=

# Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ── Odoo 19 Connection (REQUIRED) ───────────────────────────────────
ODOO_URL=https://your-company.odoo.com
ODOO_DB=your-database-name
ODOO_USERNAME=admin@yourcompany.com
ODOO_PASSWORD=1a64881339bcd77ef5bc6eb1c7becc6ab214e0b0
# Recommended: Use Odoo API key instead of password
# Odoo 19: Settings → Users → Select user → API Keys tab → Generate

# ── Tally Prime Connection (REQUIRED) ──────────────────────────────
# Tally must be running with XML Server enabled
# F12 → Connectivity → Tally Prime Server = Yes → Port = 9000
TALLY_HOST=localhost
TALLY_PORT=9000
TALLY_COMPANY_NAME=Your Company Name As In Tally

# ── Sync Settings ──────────────────────────────────────────────────
# Default schedule for automated sync
SYNC_HOUR=20
SYNC_MINUTE=0
# Default bank ledger name in Tally (for payment/receipt vouchers)
DEFAULT_BANK_LEDGER=Bank Accounts

# ── LLM Keys (Optional — only for standalone mode) ────────────────
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
